{
    "env": {
        "name": "BipedalWalkerHardcore-v3",
        "hardcore": true,
        "reward_scale": 1.0,
        "clip_observations": false,
        "clip_actions": true
    },
    "agent": {
        "type": "ppo",
        "hidden_dims": [
            400,
            300
        ],
        "learning_rate": 5e-05,
        "gamma": 0.99,
        "gae_lambda": 0.95,
        "clip_epsilon": 0.15,
        "value_loss_coef": 0.5,
        "entropy_coef": 0.02,
        "max_grad_norm": 0.5,
        "ppo_epochs": 10,
        "mini_batch_size": 64
    },
    "training": {
        "total_timesteps": 5000000,
        "rollout_steps": 2048,
        "eval_frequency": 10000,
        "eval_episodes": 10,
        "save_frequency": 100000,
        "log_frequency": 1000
    },
    "experiment": {
        "name": "ppo_hardcore",
        "seed": 42,
        "device": "cpu",
        "num_envs": 1
    },
    "paths": {
        "checkpoints": "experiments/checkpoints",
        "logs": "experiments/logs",
        "videos": "experiments/videos"
    }
}