{
    "env": {
        "name": "BipedalWalker-v3",
        "hardcore": false,
        "reward_scale": 1.0,
        "clip_observations": false,
        "clip_actions": true
    },
    "agent": {
        "type": "ppo",
        "hidden_dims": [
            256,
            256
        ],
        "learning_rate": 0.0001,
        "gamma": 0.99,
        "gae_lambda": 0.95,
        "clip_epsilon": 0.2,
        "value_loss_coef": 0.5,
        "entropy_coef": 0.03,
        "max_grad_norm": 0.5,
        "ppo_epochs": 10,
        "mini_batch_size": 64
    },
    "training": {
        "total_timesteps": 3000000,
        "rollout_steps": 4096,
        "eval_frequency": 10000,
        "eval_episodes": 10,
        "save_frequency": 50000,
        "log_frequency": 1000
    },
    "experiment": {
        "name": "ppo_exploration",
        "seed": 43,
        "device": "cpu",
        "num_envs": 1
    },
    "paths": {
        "checkpoints": "experiments/checkpoints",
        "logs": "experiments/logs",
        "videos": "experiments/videos"
    }
}